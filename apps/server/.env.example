PORT=3002
WEB_ORIGIN=http://localhost:3000
GUEST_TOKEN_SECRET=change-me
# isi true hanya jika server berada di balik reverse proxy tepercaya
TRUST_PROXY=false

# Refleksi AI (GDD 6.5). "none" = hanya insight berbasis aturan (default).
# "gemini" = Gemini server-only; "fake" = provider palsu untuk dev/tes, tidak boleh dipakai di production.
REFLECTION_PROVIDER=none
# Isi di environment server saja saat memilih gemini (jangan gunakan NEXT_PUBLIC_).
GEMINI_API_KEY=
GEMINI_MODEL=
# Batas waktu provider Refleksi (ms) sebelum memakai insight berbasis aturan.
REFLECTION_TIMEOUT_MS=15000

DEV_TOOLS=false
